TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_USERNAME=your_plane_notifier_bot
PUBLIC_BASE_URL=https://plane-notifier.example.com

PLANE_WEBHOOK_SECRET=plane_wh_replace_me
PLANE_APP_URL=https://plane.example.com
PLANE_WORKSPACE_SLUG=your-workspace

# Comma-separated Telegram numeric user IDs allowed to run /linkcode.
ADMIN_TELEGRAM_USER_IDS=123456789
LINK_CODE_TTL_MINUTES=60
DATABASE_PATH=data/notifier.sqlite3
LOG_LEVEL=INFO

# Override only if links in your Plane installation use another route.
WORK_ITEM_URL_TEMPLATE={base}/{workspace_slug}/projects/{project_id}/issues/{work_item_id}
